{
  "manifest_version": 3,
  "name": "Komoot Feed Cleanup",
  "description": "Gain control over your Komoot feed by hiding unwanted content like sponsored posts and 'Interesting in your region'.",
  "version": "2.0",
  "icons": {
    "48": "icons/scroll.png"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "js": [
        "cleanup.js"
      ],
      "matches": [
        "https://www.komoot.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "komoot-feed-cleanup@sjosch.de",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
